FROM php:8.4-cli-alpine

RUN apk add --no-cache \
    bash curl zip unzip \
    icu-dev oniguruma-dev postgresql-dev linux-headers \
    libpng-dev libjpeg-turbo-dev freetype-dev $PHPIZE_DEPS \
 && docker-php-ext-configure gd --with-freetype --with-jpeg \
 && docker-php-ext-install intl mbstring pdo pdo_pgsql pcntl opcache gd \
 && pecl install igbinary \
 && pecl install --configureoptions='enable-redis-igbinary="yes"' redis \
 && docker-php-ext-enable igbinary redis \
 && rm -rf /tmp/pear \
 && apk del $PHPIZE_DEPS

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

RUN addgroup -g 1000 app && adduser -D -G app -u 1000 app

COPY --chown=app:app . .

RUN composer install --no-dev --no-interaction --optimize-autoloader \
 && chmod -R 775 storage bootstrap/cache

COPY docker/backend/entrypoint.prod.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

USER app

ENTRYPOINT ["entrypoint.sh"]
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"]

EXPOSE 8000

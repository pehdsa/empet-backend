APP_NAME=Empet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=empet_db
DB_USERNAME=app
DB_PASSWORD=app

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=empet
AWS_ENDPOINT=http://localhost:9000
AWS_URL=http://localhost:9000/empet
AWS_USE_PATH_STYLE_ENDPOINT=true

ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

MATCH_AI_ENABLED=false
MATCH_AI_PROVIDER=null
MATCH_AI_TIMEOUT=15
MATCH_AI_MAX_PHOTOS=3
MATCH_AI_MIN_BASE_SCORE=25
MATCH_AI_MAX_PER_REPORT=5
MATCH_AI_OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
MATCH_AI_OPENAI_MODEL=gpt-4o
MATCH_AI_LOG_FIXED_SCORE=70.0
MATCH_AI_LOG_FIXED_CONFIDENCE=0.8
